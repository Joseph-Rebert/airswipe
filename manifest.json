{
  "manifest_version": 3,
  "name": "AirSwipe: Hands-Free Scrolling for Shorts & TikTok",
  "short_name": "AirSwipe",
  "version": "1.0.0",
  "description": "Swipe a finger in the air to move through YouTube Shorts and TikTok. Your webcam video never leaves your computer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AirSwipe",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
